# Скомпилированные объектные файлы, статические и разделяемые библиотеки
*.o
*.a
*.so
 
# Скомпилированные бинарники (обычно называются по имени модуля/папки)
# Если у тебя бинарник с конкретным именем — можно явно исключить его отсюда через !
*.exe
*.exe~
*.dll
*.dylib
 
# Файлы результатов тестов
*.test
 
# Вывод go coverage tool (go tool cover)
*.out
 
# Зависимости, если вендоришь их (обычно не нужно в git, если используешь go modules)
vendor/
 
# Кэш и рабочие файлы Go
go.work
go.work.sum
 
# Переменные окружения / секреты
.env
.env.local
 
# IDE / редакторы
.vscode/
.idea/
*.swp
 
# OS-специфичные файлы
.DS_Store
Thumbs.db
 
# Бинарник сборки, если собираешь в корень с определённым именем — раскомментируй и укажи своё имя
# /myapp
